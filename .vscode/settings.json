{
    "files.exclude": {
        "偏微分方程": true,
        "凸优化": true,
        "初等数学": true,
        "初等数论": true,
        "复分析": true,
        "常微分方程": true,
        "微分几何": true,
        "抽象代数": true,
        "拓扑学": true,
        "数值分析与科学计算": true,
        "泛函分析": true,
        "流形与微分形式": true,
        "测度论": true,
        "深度学习": true,
        "组合数学": true,
        "零碎概念": true,
        "temp": true,
        "tmp": true,
        "build": true,
        "**/*.aux": true,
        "**/*.bbl": true,
        "**/*.blg": true,
        "**/*.fdb_latexmk": true,
        "**/*.fls": true,
        "**/*.log": true,
        "**/*.out": true,
        "**/*.synctex.gz": true,
        "**/*.toc": true,
        "**/*.xdv": true
    },
    "latex-workshop.latex.recipe.default": "XeLaTeXmk",
    "latex-workshop.latex.auxDir": "%WORKSPACE_FOLDER%/tmp/build",
    "latex-workshop.latex.outDir": "%DIR%",
    "latex-workshop.latex.tools": [
        {
            "name": "xelatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "-auxdir=%AUXDIR%",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "XeLaTeXmk",
            "tools": [
                "xelatexmk"
            ]
        }
    ],
    "latex-workshop.latex.clean.method": "command",
    "latex-workshop.latex.clean.command": "latexmk",
    "latex-workshop.latex.clean.args": [
        "-auxdir=%AUXDIR%",
        "-outdir=%OUTDIR%",
        "-c",
        "%TEX%"
    ]
}
