{
    "files.exclude": {
        "temp": true,
        "tmp": true,
        "build": true,
        "**/*.aux": true,
        "**/*.bbl": true,
        "**/*.blg": true,
        "**/*.fdb_latexmk": true,
        "**/*.fls": true,
        "**/*.log": true,
        "**/*.out": true,
        "**/*.synctex.gz": true,
        "**/*.toc": true,
        "**/*.xdv": true
    },
    "latex-workshop.latex.recipe.default": "XeLaTeXmk (For Chinese)",
    "latex-workshop.latex.auxDir": "%WORKSPACE_FOLDER%/tmp/build",
    "latex-workshop.latex.outDir": "%DIR%",
    "latex-workshop.latex.tools": [
        {
            "name": "xelatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "-auxdir=%AUXDIR%",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "XeLaTeXmk (For Chinese)",
            "tools": [
                "xelatexmk"
            ]
        }
    ],
    "latex-workshop.latex.clean.method": "command",
    "latex-workshop.latex.clean.command": "latexmk",
    "latex-workshop.latex.clean.args": [
        "-auxdir=%AUXDIR%",
        "-outdir=%OUTDIR%",
        "-c",
        "%TEX%"
    ]
}
