\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{researchnotes}[2026/06/11 v0.2 Shared style for Chinese research notes]

% Engine and fonts.
\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{researchnotes}{Please compile with XeLaTeX or LuaLaTeX}{This style is designed for ctex documents.}
\else
  \RequirePackage{fontspec}
  \defaultfontfeatures{Ligatures=TeX}
  \IfFontExistsTF{Times New Roman}
    {\setmainfont{Times New Roman}}
    {\setmainfont{TeX Gyre Termes}}
\fi

\RequirePackage{newunicodechar}
\newunicodechar{。}{\symbol{"FF0E}}

% Page layout and typography.
% Preserve the document class spacing for the table of contents.
\makeatletter
\let\rn@toc@baselinestretch\baselinestretch
\newlength{\rn@toc@parskip}
\setlength{\rn@toc@parskip}{\parskip}
\makeatother
\RequirePackage{geometry}
\RequirePackage{setspace}
\geometry{
  a4paper,
  left=2.2cm,
  right=2.2cm,
  top=2.4cm,
  bottom=2.4cm,
  headheight=15pt
}
\setlength{\parindent}{2em}
\setlength{\parskip}{0.25em}
\setstretch{1.3}
\emergencystretch=2em

% Math.
\RequirePackage{mathtools}
\RequirePackage{amsthm}
\RequirePackage{amssymb}
\allowdisplaybreaks[2]
\numberwithin{equation}{section}

% Tables and figures.
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{diagbox}
\RequirePackage{caption}
\RequirePackage{subcaption}
\captionsetup{font=small,labelfont=bf,skip=4pt}
\setlength{\textfloatsep}{8pt plus 2pt minus 2pt}
\setlength{\intextsep}{8pt plus 2pt minus 2pt}
\setlength{\floatsep}{10pt plus 2pt minus 2pt}
\renewcommand{\arraystretch}{1.12}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\numberwithin{figure}{section}
\numberwithin{table}{section}

% Lists.
\RequirePackage{enumitem}
\setlist[itemize]{itemsep=0.15em,topsep=0.25em,parsep=0pt,partopsep=0pt}
\setlist[enumerate]{itemsep=0.2em,topsep=0.25em,parsep=0pt,partopsep=0pt}
\setlist[description]{itemsep=0.15em,topsep=0.25em,parsep=0pt,partopsep=0pt}

% Page style.
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\cfoot{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Section spacing for ctex classes.
\makeatletter
\newcommand{\rn@restoretocheading}{}
\@ifundefined{ctexset}{}{
  % Save the class heading style before applying the body heading style.
  \let\rn@toc@format\CTEX@section@format
  \let\rn@toc@beforeskip\CTEX@section@beforeskip
  \let\rn@toc@afterskip\CTEX@section@afterskip
  \renewcommand{\rn@restoretocheading}{%
    \let\CTEX@section@format\rn@toc@format
    \let\CTEX@section@beforeskip\rn@toc@beforeskip
    \let\CTEX@section@afterskip\rn@toc@afterskip
  }
  \ctexset{
    section = {
      format = \centering\Large\bfseries,
      beforeskip = 1.1ex plus 0.3ex minus 0.2ex,
      afterskip = 0.7ex plus 0.2ex
    },
    subsection = {
      format = \large\bfseries,
      beforeskip = 0.9ex plus 0.2ex minus 0.2ex,
      afterskip = 0.5ex plus 0.2ex
    }
  }
}
\makeatother

% Theorem-like environments.
\newtheoremstyle{rn-theorem}
  {0.7em}
  {0.7em}
  {\setlength{\parindent}{0pt}}
  {0pt}
  {\bfseries}
  {}
  {0.8em}
  {}
\theoremstyle{rn-theorem}
\newtheorem{theorem}{定理}[section]
\newtheorem{lemma}{引理}[section]
\newtheorem{proposition}{命题}[section]
\newtheorem{corollary}{推论}[section]
\newtheorem{definition}{定义}[section]
\newtheorem{example}{例题}[section]
\newtheorem{remark}{备注}[section]
\newtheorem{axiom}{公理}[section]
\newtheorem{conjecture}{猜想}[section]
\newtheorem{claim}{断言}[section]
\newtheorem{property}{性质}[section]
\newtheorem{observation}{观察}[section]
\newtheorem{notation}{符号}[section]

\makeatletter
\newenvironment{solve}[1][解]{\par
  \color{blue}%
  \setlength{\parindent}{0pt}%
  \pushQED{\qed}%
  \normalfont \topsep6\p@\@plus6\p@\relax
  \trivlist
  \item[\hskip\labelsep \bfseries #1\hskip 0.8em]\ignorespaces
}{%
  \popQED\endtrivlist\@endpefalse
}

\newenvironment{analyze}[1][分析]{\par
  \color{blue}%
  \setlength{\parindent}{0pt}%
  \normalfont \topsep6\p@\@plus6\p@\relax
  \trivlist
  \item[\hskip\labelsep \bfseries #1\hskip 0.8em]\ignorespaces
}{%
  \endtrivlist\@endpefalse
}

\renewenvironment{proof}[1][\proofname]{\par
  \color{blue}%
  \setlength{\parindent}{0pt}%
  \pushQED{\qed}%
  \normalfont \topsep6\p@\@plus6\p@\relax
  \trivlist
  \item[\hskip\labelsep \bfseries #1\hskip 0.8em]\ignorespaces
}{%
  \popQED\endtrivlist\@endpefalse
}

\makeatother

% Common colors and note helpers.
\definecolor{rnorange}{HTML}{FF5F15}
\definecolor{rngreen}{HTML}{27AE60}
\definecolor{rnlinkblue}{HTML}{1F4E99}
\colorlet{myorange}{rnorange}
\colorlet{mygreen}{rngreen}
\colorlet{mylinkblue}{rnlinkblue}
\newcommand{\impo}[1]{\textcolor{blue}{#1}}
\newcommand{\explain}[1]{\textcolor{rngreen}{#1}}
\DeclareRobustCommand{\keyterm}[1]{{\kaishu\mdseries #1}}
\newcommand{\idea}[1]{\par\vspace{0.45em}\noindent\textbf{#1}}
\newenvironment{whispers}
  {\par\color{purple}\itshape}
  {\par}

% Hyperlinks should be loaded late.
\RequirePackage{hyperref}
\hypersetup{
  unicode=true,
  hypertexnames=false,
  colorlinks=true,
  linkcolor=rnlinkblue,
  urlcolor=rnlinkblue,
  citecolor=rnlinkblue,
  pdfborder={0 0 0}
}

% Keep the class's default contents title, layout and spacing. Links remain
% clickable, but use the normal text appearance within the contents only.
\makeatletter
\AddToHook{cmd/tableofcontents/before}{%
  \begingroup
  \hypersetup{hidelinks}%
  \let\baselinestretch\rn@toc@baselinestretch
  \selectfont
  \setlength{\parskip}{\rn@toc@parskip}%
  \rn@restoretocheading
}
\AddToHook{cmd/tableofcontents/after}{\endgroup}
\makeatother

\endinput
